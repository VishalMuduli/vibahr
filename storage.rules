    // Tenant-isolated storage bucket structure
    match /tenants/{tenantId}/companies/{companyId}/{folder}/{fileName} {
      allow read: if request.auth != null
        && request.auth.token.tenantId == tenantId
        && request.auth.token.companyId == companyId;
      
      // Enforce file size limit (15MB max) and authenticated tenant scope
      allow write: if request.auth != null
        && request.auth.token.tenantId == tenantId
        && request.auth.token.companyId == companyId
        && request.resource.size < 15 * 1024 * 1024;
    }

    // Public Assets (e.g. company logo, app icons)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'super_admin';
    }

    match /{allPaths=**} { 
      allow read, write: if false; 
    }
